{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "techmentors-lms",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --max-warnings=0",
        "format": "prettier --write \"resources/js/**/*.{ts,tsx}\" resources/css/app.css \"tests/js/**/*.{ts,tsx}\" \"tests/e2e/**/*.{ts,mjs}\" vite.config.js vitest.config.ts playwright.config.ts eslint.config.js tsconfig.json package.json",
        "format:check": "prettier --check \"resources/js/**/*.{ts,tsx}\" resources/css/app.css \"tests/js/**/*.{ts,tsx}\" \"tests/e2e/**/*.{ts,mjs}\" vite.config.js vitest.config.ts playwright.config.ts eslint.config.js tsconfig.json package.json",
        "test:unit": "vitest run",
        "test:e2e": "playwright test"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^10.13.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.13.0",
        "jsdom": "^30.1.3",
        "laravel-vite-plugin": "^3.2.0",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0",
        "vite": "^8.3.5",
        "vitest": "^5.1.0"
    },
    "dependencies": {
        "@inertiajs/react": "^3.9.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    }
}
