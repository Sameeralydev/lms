APP_ENV=testing
APP_NAME="TechMentors.PK"
APP_DEBUG=false
APP_KEY=
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
APP_TIMEZONE=UTC

# All automated tests default to this forced in-memory SQLite profile.
TESTING_PROFILE=sqlite
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_SOCKET=
DB_URL=
CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SESSION_ENCRYPT=true

# Optional guarded local MySQL profiles. Put credentials only in ignored .env.testing.
# Database and account identities are pinned by the corresponding reviewed target.
TESTING_MYSQL_HOST=127.0.0.1
TESTING_MYSQL_PORT=3306
TESTING_MYSQL_PHASE15_PORT=
TESTING_MYSQL_PHASE01_USERNAME=
TESTING_MYSQL_PHASE01_PASSWORD=
TESTING_MYSQL_PHASE04_USERNAME=
TESTING_MYSQL_PHASE04_PASSWORD=
TESTING_MYSQL_PHASE04V2_USERNAME=
TESTING_MYSQL_PHASE04V2_PASSWORD=
TESTING_MYSQL_PHASE05_USERNAME=
TESTING_MYSQL_PHASE05_PASSWORD=
TESTING_MYSQL_PHASE06_USERNAME=
TESTING_MYSQL_PHASE06_PASSWORD=
TESTING_MYSQL_PHASE06_DISPOSABLE=
TESTING_MYSQL_PHASE07_USERNAME=
TESTING_MYSQL_PHASE07_PASSWORD=
TESTING_MYSQL_PHASE07_DISPOSABLE=
