# Exact @@server_uuid returned by the reviewed dedicated Phase 15 MySQL test server.
TESTING_MYSQL_PHASE15_SERVER_UUID=
# Canonical data directory of the reviewed dedicated Phase 15 MySQL instance.
TESTING_MYSQL_PHASE15_DATA_DIRECTORY=

ADMISSIONS_DOCUMENT_SCANNER=unavailable
ADMISSIONS_CLAMAV_BINARY=
ADMISSIONS_CLAMAV_SIGNATURE_DIRECTORY=
ADMISSIONS_SIGTOOL_BINARY=
ADMISSIONS_CLAMAV_MAX_SIGNATURE_AGE_HOURS=48
ADMISSIONS_CLAMAV_TIMEZONE=UTC
ADMISSIONS_CLAMAV_TIMEOUT=10
